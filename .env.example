# Copia este archivo como .env y llena los valores.
# ⚠️ NUNCA subas el .env real a GitHub (ya está en .gitignore).
# En producción estas variables se configuran en Vercel:
#   Project Settings → Environment Variables

# --- Supabase (cuentas y login) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (suscripción Pro $14.99/mes) ---
STRIPE_SECRET_KEY=

# --- IA (generación de planes y contador de comidas) ---
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=

# --- Meta Pixel de Facebook (anuncios pagados) ---
# Es el ID numérico del pixel que sale en Meta Events Manager (ej: 1234567890123456).
# Es un dato público (va en el HTML de cualquier sitio con anuncios), pero lo
# guardamos aquí para no dejarlo escrito dentro del código.
META_PIXEL_ID=
